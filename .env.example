# Application Environment Configuration
# Copy this file to .env and replace placeholder values with your local/production settings

# Server
PORT=8080
SERVER_PORT=8080

# MySQL Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_NAME=snovasys_banking
DB_USERNAME=root
DB_PASSWORD=your_mysql_password_here

# JWT Security
